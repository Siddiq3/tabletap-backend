{
  "name": "tabletap-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsup src/index.ts --format esm --target node20 --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:backup": "pg_dump \"$DATABASE_URL\" --no-owner --no-privileges -Fc -f backup.dump",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@supabase/supabase-js": "2.119.0",
    "hono": "4.13.17"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
