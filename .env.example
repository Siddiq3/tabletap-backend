DATA_BACKEND=supabase
PORT=4000

# Supabase → Project Settings → API. Server only: never put these in web or app.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Web origins allowed to call the API (comma separated). The mobile app needs no entry.
CORS_ORIGINS=http://localhost:3000

# Only for `npm run db:backup`
DATABASE_URL=
