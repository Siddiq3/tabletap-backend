DATA_BACKEND=supabase
PORT=4000

# Supabase → Project Settings → API. Server only: never put these in web or app.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Web origins allowed to call the API (comma separated). The mobile app needs no entry.
CORS_ORIGINS=http://localhost:3000

# Only for `npm run db:backup`
DATABASE_URL=

# Where Supabase's password-reset email links to (the web's reset page). Also add it to
# Supabase → Authentication → URL Configuration → Redirect URLs.
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Outgoing email (verification codes, password resets). console = print to this terminal (local dev).
# resend = send through Resend; MAIL_FROM must be on a domain verified in Resend.
MAILER=console
RESEND_API_KEY=
MAIL_FROM=Tabletap <no-reply@your-domain>
